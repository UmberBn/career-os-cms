    },
    "location": {
      "type": "string"
    },
    "languages": {
      "type": "component",
      "repeatable": true,
      "component": "profile.language"
    },
    "github": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "availability": {
      "type": "enumeration",
      "enum": ["open", "selective", "unavailable"]
    }
  }
}
